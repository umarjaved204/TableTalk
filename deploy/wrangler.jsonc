// The Cloudflare Worker that serves the website: static files only, no Worker
// code ("main" is left out on purpose). The deploy job puts the built site
// (web/dist from the build job) into ./dist and runs `wrangler deploy` here.
// Every hosting setting lives in this file, reviewed as code; nothing is set
// by hand in the Cloudflare dashboard. See docs/runbook.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tabletalk",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Pages are folders (/premier-league/ -> premier-league/index.html);
    // /premier-league is redirected to /premier-league/.
    "html_handling": "auto-trailing-slash",
    // An unknown address gets dist/404.html with status 404.
    "not_found_handling": "404-page"
  },
  // The site's one address: the custom domain. Cloudflare creates its DNS
  // record and certificate; no DNS record is added by hand.
  "routes": [{ "pattern": "tabletalk.fyi", "custom_domain": true }],
  // Go-live stage 3: the workers.dev address (tabletalk.umarjaved.workers.dev)
  // is off. Cloudflare adds Network Error Logging headers there that can't be
  // switched off, and one address means one place to check.
  "workers_dev": false,
  // No public preview address for each uploaded version.
  "preview_urls": false,
  // No Worker code runs, so there is nothing to log.
  "observability": { "enabled": false }
}
