# Data: raw downloads and processed caches are reproducible, so they are not tracked.
data/raw/
data/processed/
*.csv.gz

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Notebook outputs are regenerated; keep the repo diff-able.
notebooks/*.html

# OS / editor
.DS_Store
.vscode/
.idea/

# Ad-hoc exports from `--save` written to the project root.
/*.csv

# Local secrets (e.g. FOOTBALL_DATA_API_KEY). Never commit an API key.
.env
