---
// The Appearance picker: a button that opens a native <dialog> holding a
// radio group. Native radios give keyboard arrows and screen-reader
// announcements for free. Each swatch is drawn with the theme's own tokens by
// giving it data-theme="<id>", so no colour values appear here.
import { PICKER_OPTIONS } from "../themes.ts";
---

<button type="button" class="open" data-open-appearance aria-haspopup="dialog">
  <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
    <circle cx="10" cy="10" r="8"></circle>
    <path d="M10 2a8 8 0 0 1 0 16z"></path>
  </svg>
  Appearance
</button>

<dialog id="appearance" aria-labelledby="appearance-title">
  <div class="panel">
    <div class="head">
      <h2 id="appearance-title">Appearance</h2>
      <button type="button" class="close" data-close>
        Close
      </button>
    </div>
    <fieldset>
      <legend class="visually-hidden">Theme</legend>
      {PICKER_OPTIONS.map((option) => (
        <div class="option">
          <input type="radio" name="theme" id={`theme-${option.id}`} value={option.id} />
          <label for={`theme-${option.id}`}>
            {option.id === "system" ? (
              <span class="swatch split" aria-hidden="true">
                <span data-theme="matchday" />
                <span data-theme="floodlights" />
              </span>
            ) : (
              <span class="swatch" data-theme={option.id} aria-hidden="true">
                <span class="lines" />
                <span class="accent" />
              </span>
            )}
            <span class="text">
              <span class="name">{option.name}</span>
              <span class="description">{option.description}</span>
            </span>
            <span class="tick" aria-hidden="true" />
          </label>
        </div>
      ))}
    </fieldset>
    <p class="note">Your choice is saved in this browser only. No cookies, no account.</p>
  </div>
</dialog>

<script>
  import "../scripts/theme-picker.ts";
</script>

<style>
  .open {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-main);
    padding: 0 var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
  }

  .open svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.6;
  }

  .open svg path {
    fill: currentcolor;
  }

  dialog {
    width: min(560px, calc(100vw - 2 * var(--space-4)));
    max-height: calc(100dvh - 2 * var(--space-4));
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-2);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-2);
  }

  dialog::backdrop {
    background: color-mix(in srgb, var(--bg) 70%, transparent);
  }

  .panel {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }

  .close {
    min-height: var(--tap-main);
    padding: 0 var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-2);
    background: transparent;
    color: var(--text);
    font-family: var(--font-text);
    font-size: var(--step-0);
    font-weight: 600;
    cursor: pointer;
  }

  fieldset {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .option {
    position: relative;
  }

  /* The real radio covers the whole row, invisible, so the row is the target
     and the browser's own radio-group behaviour is kept. */
  .option input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .option label {
    display: grid;
    grid-template-columns: 56px 1fr 24px;
    align-items: center;
    gap: var(--space-3);
    min-height: 60px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-2);
    background: var(--surface);
  }

  .option input:checked + label {
    border: 2px solid var(--accent);
    padding: calc(var(--space-2) - 1px) calc(var(--space-3) - 1px);
  }

  .option input:focus-visible + label {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .swatch {
    display: grid;
    grid-template-columns: 2fr 1fr;
    width: 56px;
    height: 40px;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--bg);
  }

  .swatch.split {
    grid-template-columns: 1fr 1fr;
  }

  .swatch.split > span {
    background: var(--bg);
  }

  .lines {
    position: relative;
  }

  .lines::before,
  .lines::after {
    content: "";
    position: absolute;
    left: 7px;
    right: 7px;
    height: 4px;
    border-radius: 2px;
  }

  .lines::before {
    top: 12px;
    background: var(--text);
  }

  .lines::after {
    top: 21px;
    background: var(--text-muted);
  }

  .accent {
    background: var(--accent);
  }

  .text {
    display: grid;
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .description {
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.3;
  }

  .tick {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 1.5px solid var(--border-strong);
    border-radius: 50%;
  }

  .option input:checked + label .tick {
    background: var(--accent);
    border-color: var(--accent);
  }

  .option input:checked + label .tick::after {
    content: "";
    width: 6px;
    height: 11px;
    border: solid var(--on-accent);
    border-width: 0 2.5px 2.5px 0;
    transform: translateY(-1px) rotate(45deg);
  }

  .note {
    font-size: var(--step--1);
    color: var(--text-muted);
  }
</style>
