---
// Brand, the two site-wide pages, and the theme picker. On narrow screens the
// links take their own row under the brand, so nothing is squeezed.
import ThemePicker from "./ThemePicker.astro";

const path = Astro.url.pathname;
const LINKS = [
  { href: "/track-record/", text: "Track record" },
  { href: "/methodology/", text: "Methodology" },
];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">
      <svg class="mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="2" x2="12" y2="22"></line>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
      TableTalk
    </a>
    <nav class="site-nav" aria-label="Site">
      <ul>
        {LINKS.map((link) => (
          <li>
            <a href={link.href} aria-current={path === link.href ? "page" : undefined}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemePicker />
  </div>
</header>

<style>
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    min-height: 56px;
    padding-block: var(--space-1);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-main);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--text);
    text-decoration: none;
  }

  /* Narrow screens: a full-width row under the brand and Appearance. */
  .site-nav {
    order: 3;
    flex-basis: 100%;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-main);
    border-bottom: 3px solid transparent;
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--text);
  }

  .site-nav a[aria-current="page"] {
    color: var(--text);
    border-bottom-color: var(--accent);
  }

  @media (width >= 700px) {
    .site-nav {
      order: 0;
      flex-basis: auto;
      margin-left: auto;
    }
  }

  .mark {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.6;
  }
</style>
