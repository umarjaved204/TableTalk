---
// One upcoming match, scoreboard style: home team, kick-off clock, away team,
// then the three-way probabilities, the likeliest score and expected goals.
//
// The status line says when the prediction was made. For an upcoming match
// that is the snapshot's time ("Prediction as of ..."); it becomes locked at
// kick-off. Locked, played and voided matches come in Step 3.
import type { UpcomingMatch } from "../data/models.ts";
import { formatGoals } from "../format/number.ts";
import { formatChance, matchPercents } from "../format/probability.ts";
import { formatClock, formatDateTime } from "../format/time.ts";
import ProbabilityBar from "./ProbabilityBar.astro";

interface Props {
  match: UpcomingMatch;
  /** When this prediction was made: the snapshot's generated_at. */
  predictedAt: string;
}
const { match, predictedAt } = Astro.props;
const percents = matchPercents(match.probabilities);
const likeliest = match.likelyScorelines[0];

// The fixture source's status, in words. TIMED and SCHEDULED are both upcoming.
const STATUS_LABELS: Record<string, string> = {
  POSTPONED: "Postponed",
  SUSPENDED: "Suspended",
  CANCELLED: "Cancelled",
  IN_PLAY: "In play",
  PAUSED: "In play",
};
const statusLabel = (match.status && STATUS_LABELS[match.status]) || "Upcoming";
---

<article
  class="match"
  data-match
  data-kickoff={match.kickoffUtc ?? undefined}
  data-date={match.date ?? undefined}
  aria-label={`${match.home} v ${match.away}`}
>
  <div class="scoreboard">
    <span class="team home">{match.home}</span>
    <span class="clock">
      {match.kickoffUtc ? (
        <time datetime={match.kickoffUtc} data-format="clock">
          {formatClock(match.kickoffUtc, "UTC")}
        </time>
      ) : (
        <abbr title="Time to be confirmed">TBC</abbr>
      )}
    </span>
    <span class="team away">{match.away}</span>
  </div>

  <ProbabilityBar percents={percents} />
  <p class="outcomes">
    <span>
      <span aria-hidden="true">Home</span>
      <span class="visually-hidden">{match.home} win</span> <strong>{percents.home}%</strong>
    </span>
    <span>
      Draw <strong>{percents.draw}%</strong>
    </span>
    <span>
      <span aria-hidden="true">Away</span>
      <span class="visually-hidden">{match.away} win</span> <strong>{percents.away}%</strong>
    </span>
  </p>

  <p class="detail">
    {likeliest && (
      <span>
        Most likely {likeliest.home}–{likeliest.away} ({formatChance(likeliest.probability)})
      </span>
    )}
    <span>
      Expected goals {formatGoals(match.expectedGoals.home)}–{formatGoals(match.expectedGoals.away)}
    </span>
    {!match.kickoffUtc && <span>Time to be confirmed</span>}
  </p>

  <p class="status">
    <span class="badge" data-status-badge>
      {statusLabel}
    </span>
    <span data-lock-note>
      Prediction as of{" "}
      <time datetime={predictedAt} data-format="datetime">
        {formatDateTime(predictedAt, "UTC")}
      </time>{" "}
      · locks at kick-off
    </span>
  </p>
</article>

<style>
  .match {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .scoreboard {
    display: grid;

    /* minmax(0, ...) lets the name columns shrink, so long names wrap instead of overflowing */
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3);
  }

  .team {
    font-weight: 600;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .home {
    text-align: right;
  }

  .clock {
    min-width: 4.4em;
    padding: 2px var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-1);
    background: var(--surface-2);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.03em;
    text-align: center;
  }

  .clock abbr {
    font-size: var(--step-0);
  }

  .outcomes,
  .detail,
  .status {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .outcomes {
    justify-content: space-between;
  }

  .outcomes strong {
    color: var(--text);
  }

  .badge {
    padding: 0 var(--space-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-1);
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
