---
// What a league page shows instead of numbers when it has none to show, in
// the visitor's words. The update's own error message is for the site's
// owner: it stays in the published run report, not on the page.
import type { UnavailableLeague, UnsupportedLeague } from "../data/models.ts";
import Notice from "./Notice.astro";

interface Props {
  data: UnavailableLeague | UnsupportedLeague;
}
const { data } = Astro.props;
const name = data.league.name;
---

{data.state === "unsupported" ? (
  <Notice title="This league's numbers are hidden" tone="warn">
    <p>
      Its latest numbers are in a newer format than this site can read, so they are hidden rather than shown
      wrongly. The site will be updated to read them.
    </p>
  </Notice>
) : (
  <Notice title={`No forecast for ${name} right now`} tone="warn">
    <p>
      {data.reason === "no_snapshot"
        ? "Last night's update didn't produce one."
        : "Its forecast couldn't be loaded, so it isn't shown."}
    </p>
    <p>The other leagues are not affected. Updates run every night.</p>
  </Notice>
)}
