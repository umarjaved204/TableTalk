---
// Team x finishing position. A real table, so it is its own text version:
// every coloured cell prints its value, and cells under 0.5% are blank (a run
// of blank cells is one cell spanning those positions: heatCells).
import type { TeamRow } from "../data/models.ts";
import { heatCells } from "../format/heat.ts";

interface Props {
  leagueName: string;
  rows: TeamRow[];
  nSimulations: number;
}
const { leagueName, rows, nSimulations } = Astro.props;
const simulations = new Intl.NumberFormat("en-GB").format(nSimulations);
// Ordered by average finishing position, so the likely finishes form a diagonal.
const byExpected = [...rows].sort((a, b) => expectedPosition(a) - expectedPosition(b));
const positions = rows.map((_, i) => i + 1);

function expectedPosition(row: TeamRow): number {
  return row.finishing.reduce((sum, p, i) => sum + p * (i + 1), 0);
}
import { teamSlug } from "../data/teams.ts";
import FavName from "./FavName.astro";
---

<div class="heatmap">
  <p class="caption" id="heatmap-caption">
    Chance of each finishing position, in % of {simulations} simulated seasons. Blank means under 0.5%. Teams
    are ordered by their average finishing position.
  </p>
  <div class="scroll" role="region" aria-labelledby="heatmap-caption" tabindex="0">
    <table>
      <caption class="visually-hidden">{leagueName}: chance of each finishing position (%)</caption>
      <thead>
        <tr>
          <th scope="col" class="team">
            Team
          </th>
          {positions.map((p) => (
            <th scope="col">{p}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {byExpected.map((row) => (
          <tr data-team={teamSlug(row.team)}>
            <th scope="row" class="team">
              <FavName name={row.team} />
            </th>
            {heatCells(row.finishing).map((cell) => (
              <td class={`heat-${cell.step}`} colspan={cell.span > 1 ? cell.span : undefined}>
                {cell.label}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="legend" aria-hidden="true">
    <span>Less likely</span>
    <span class="ramp">
      <i class="heat-1"></i>
      <i class="heat-2"></i>
      <i class="heat-3"></i>
      <i class="heat-4"></i>
      <i class="heat-5"></i>
      <i class="heat-6"></i>
      <i class="heat-7"></i>
    </span>
    <span>More likely</span>
  </div>
</div>

<style>
  .heatmap {
    display: grid;
    grid-template-columns: minmax(0, 1fr); /* never wider than the panel */
    gap: var(--space-3);
    min-width: 0;
    padding-block: var(--space-3);
  }

  .caption,
  .legend {
    padding-inline: var(--space-4);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .scroll {
    overflow-x: auto;
  }

  table {
    border-collapse: separate;
    border-spacing: 2px;
    font-size: var(--step--1); /* 13.4px: numbers stay readable on phones */
  }

  th,
  td {
    min-width: 2.3rem;
    height: 2rem;
    padding: 0 var(--space-1);
    text-align: center;
    white-space: nowrap;
  }

  thead th {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--text-muted);
  }

  .team {
    position: sticky;
    left: 0;
    z-index: 1;
    min-width: 8.5rem;
    max-width: 11rem;
    padding-inline: var(--space-2) var(--space-3);
    background: var(--surface);
    text-align: left;
    white-space: normal;
    font-weight: 600;
    font-size: var(--step--1);
    line-height: 1.2;
  }

  td {
    border-radius: 3px;
    font-weight: 600;
  }

  .heat-1 {
    background: var(--heat-1);
    color: var(--heat-ink-1);
  }

  .heat-2 {
    background: var(--heat-2);
    color: var(--heat-ink-2);
  }

  .heat-3 {
    background: var(--heat-3);
    color: var(--heat-ink-3);
  }

  .heat-4 {
    background: var(--heat-4);
    color: var(--heat-ink-4);
  }

  .heat-5 {
    background: var(--heat-5);
    color: var(--heat-ink-5);
  }

  .heat-6 {
    background: var(--heat-6);
    color: var(--heat-ink-6);
  }

  .heat-7 {
    background: var(--heat-7);
    color: var(--heat-ink-7);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .ramp {
    display: inline-flex;
    gap: 2px;
  }

  .ramp i {
    display: block;
    width: 18px;
    height: 12px;
    border-radius: 2px;
  }

  @media (forced-colors: active) {
    td[class^="heat-"]:not(.heat-0) {
      border: 1px solid CanvasText;
    }
  }
</style>
