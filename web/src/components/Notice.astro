---
// A block message: provisional data, unavailable data, unsupported format.
interface Props {
  title: string;
  tone?: "info" | "warn";
}
const { title, tone = "info" } = Astro.props;
---

<div class:list={["notice", tone]} role={tone === "warn" ? "status" : undefined}>
  <p class="title">{title}</p>
  <div class="body">
    <slot />
  </div>
</div>

<style>
  .notice {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border-strong);
    border-left-width: 4px;
    border-radius: var(--radius-1);
    background: var(--surface);
  }

  .warn {
    background: var(--warn-bg);
    color: var(--warn-text);
    border-color: var(--warn-text);
  }

  .title {
    font-weight: 700;
  }
</style>
