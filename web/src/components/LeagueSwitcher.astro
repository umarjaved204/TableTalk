---
// One row of league chips. It never wraps: on a narrow phone it scrolls
// sideways (the cut-off chip shows there is more), and the current league
// is scrolled into view on load.
import { LEAGUES } from "../data/leagues.ts";

interface Props {
  current: string;
}
const { current } = Astro.props;
---

<nav class="switcher" aria-label="Leagues">
  <ul class="container" data-switcher>
    {LEAGUES.map((league) => (
      <li>
        <a href={`/${league.slug}/`} aria-current={league.slug === current ? "page" : undefined}>
          {league.name}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  const current = document.querySelector<HTMLElement>("[data-switcher] [aria-current='page']");
  const list = current?.closest<HTMLElement>("[data-switcher]");
  // Only scroll when the current league's chip is (partly) out of view.
  if (current && list && current.offsetLeft + current.offsetWidth > list.clientWidth) {
    list.scrollLeft = current.offsetLeft - list.clientWidth / 2 + current.offsetWidth / 2;
  }
</script>

<style>
  .switcher {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  ul {
    display: flex;
    gap: var(--space-2);
    margin: 0 auto;
    padding-block: var(--space-2);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }

  li {
    flex: none;
    scroll-snap-align: start;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-main);
    padding: 0 var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    color: var(--text);
    white-space: nowrap;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  a:hover {
    border-color: var(--text);
  }

  a[aria-current="page"] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
</style>
