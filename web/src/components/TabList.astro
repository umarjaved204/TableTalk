---
// The phone tab bar for a page's sections (used with scripts/tabs.ts).
// Shown only on narrow screens and only with JavaScript: the theme script
// marks the page with data-js before the first paint, so the bar is there
// from the start and nothing moves when tabs.ts runs. Without JavaScript
// every section is simply shown one after another.
interface Props {
  /** Each tab's section id and label, in order. */
  tabs: { id: string; label: string }[];
}
const { tabs } = Astro.props;
---

<div class="tablist" data-tablist>
  {tabs.map((tab) => (
    <button type="button" id={`tab-${tab.id}`} data-tab={tab.id}>
      {tab.label}
    </button>
  ))}
</div>

<style>
  .tablist {
    display: none;
    flex-wrap: wrap; /* very large text: tabs go onto two rows rather than off-screen */
    border-bottom: 1px solid var(--border);
  }

  @media (width < 900px) {
    :global([data-js]) .tablist:not([hidden]) {
      display: flex;
    }
  }

  button {
    flex: 1 0 auto;
    min-height: var(--tap-main);
    border: 0;
    border-bottom: 3px solid transparent;
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
  }

  button[aria-selected="true"] {
    color: var(--text);
    border-bottom-color: var(--accent);
  }
</style>
