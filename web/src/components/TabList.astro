---
// The phone tab bar for a page's sections (used with scripts/tabs.ts).
// Hidden until the script shows it, and only on narrow screens: without
// JavaScript every section is simply shown one after another.
interface Props {
  /** Each tab's section id and label, in order. */
  tabs: { id: string; label: string }[];
}
const { tabs } = Astro.props;
---

<div class="tablist" data-tablist hidden>
  {tabs.map((tab) => (
    <button type="button" id={`tab-${tab.id}`} data-tab={tab.id}>
      {tab.label}
    </button>
  ))}
</div>

<style>
  .tablist {
    display: flex;
    flex-wrap: wrap; /* very large text: tabs go onto two rows rather than off-screen */
    border-bottom: 1px solid var(--border);
  }

  .tablist[hidden] {
    display: none;
  }

  button {
    flex: 1 0 auto;
    min-height: var(--tap-main);
    border: 0;
    border-bottom: 3px solid transparent;
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
  }

  button[aria-selected="true"] {
    color: var(--text);
    border-bottom-color: var(--accent);
  }
</style>
