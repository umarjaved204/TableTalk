---
// "Your team": a header button that opens a native <dialog> with a team
// picker: a row of league buttons, then that league's teams as native radio
// buttons (src/scripts/team-picker.ts). The picker is built the first time
// the dialog opens, from the team list in the early script, so it doesn't add
// to every page. Saving is an explicit button: arrow keys check each radio as
// they move, so saving on change would store teams the visitor only passed over.
//
// Only the middle of the dialog scrolls. The footer (what's selected, Save,
// Remove) stays in view below it, so it never covers a focused team.
//
// The dialog also explains where the choice lives and how to keep it:
//   - some browsers delete site storage after a while without a visit
//     (Safari: 7 days of Safari use), so the team's own page is the bookmark to keep
//     (it needs no stored data);
//   - an app added to the home screen keeps its own settings.
import { FAV_STORAGE_KEY } from "../scripts/theme-script.ts";
---

<button type="button" class="open" data-open-favourite aria-haspopup="dialog" data-needs-js>
  <span class="icon" aria-hidden="true"></span>
  Your team
</button>

<dialog id="favourite" aria-labelledby="favourite-title">
  <div class="head">
    <h2 id="favourite-title">Your team</h2>
    <button type="button" class="button" data-close>
      Close
    </button>
  </div>

  <div class="body">
    <!-- Filled by src/scripts/team-picker.ts when the dialog first opens. -->
    <div class="picker" data-picker></div>
    <p class="warning" data-storage-warning hidden>
      This browser isn't letting the site remember your choice (a private window, or a setting), so it applies
      until you close this page.
    </p>

    <div class="keep" data-when-chosen>
      <!-- The link is set to the favourite's page by src/scripts/favourites.ts. -->
      <p data-team-page-tip>
        Some browsers forget this after a while.{" "}
        <a href="/" data-team-page-link>
          Bookmark your team's page
        </a>{" "}
        to keep it.
      </p>
    </div>

    <details>
      <summary>Add TableTalk to your home screen</summary>
      <p>
        On iPhone or iPad: tap Share, then Add to Home Screen. On Android: open the browser menu, then Add to
        Home screen or Install.
      </p>
      <p class="muted">
        An app added to the home screen keeps its own settings, separate from your browser, so pick your team
        again the first time you open it. After that it keeps your choice.
      </p>
    </details>

    <p class="note">
      Saved only in this browser (key <code>{FAV_STORAGE_KEY}</code>). No account, no cookies, nothing sent
      anywhere. <a href="/about/#your-team">What's stored and how to remove it</a>
    </p>
  </div>

  <div class="foot">
    <p class="selected" data-picker-selected>
      No team selected
    </p>
    <p class="actions">
      <button type="button" class="button primary" data-fav-action="save-picker">
        Save
      </button>
      <button type="button" class="button" data-fav-action="remove" data-when-chosen>
        Remove my team
      </button>
    </p>
    <p class="status" role="status" data-fav-dialog-status></p>
  </div>
</dialog>

<script>
  import "../scripts/favourites.ts";
</script>

<style>
  .open {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-main);
    padding: 0 var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
  }

  /* An outline star, filled once a team is chosen (set before the first paint). */
  .icon {
    width: 18px;
    height: 18px;
    background: currentcolor;
    mask: var(--star-outline-mask) center / contain no-repeat;
  }

  :global(:root[data-fav-state="chosen"]) .icon {
    background: var(--accent);
    mask-image: var(--star-mask);
  }

  dialog {
    width: min(720px, calc(100vw - 2 * var(--space-4)));
    max-height: calc(100dvh - 2 * var(--space-4));
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-2);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-2);
  }

  /* Head, a scrolling middle, and a footer that stays in view. */
  dialog[open] {
    display: flex;
    flex-direction: column;
  }

  dialog::backdrop {
    background: color-mix(in srgb, var(--bg) 70%, transparent);
  }

  .head,
  .body,
  .foot {
    padding-inline: var(--space-4);
  }

  .head {
    display: flex;
    flex: none;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-4) var(--space-2);
  }

  .body {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    min-height: 0;
    padding-block: var(--space-2) var(--space-4);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .foot {
    display: grid;
    flex: none;
    gap: var(--space-2);
    padding-block: var(--space-3) var(--space-4);
    border-top: 1px solid var(--border);
  }

  @media (width >= 600px) {
    .head,
    .body,
    .foot {
      padding-inline: var(--space-5);
    }
  }

  /* Large text or a short window: the whole dialog scrolls, the footer after
     the teams (pinFooter() in src/scripts/favourites.ts decides, by measuring). */
  dialog[open].unpinned {
    display: block;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .unpinned .body {
    overflow: visible;
  }

  .selected {
    color: var(--text-muted);
    font-size: var(--step--1);
    overflow-wrap: anywhere;
  }

  .selected :global(b) {
    color: var(--text);
  }

  /* ---- The picker (built by src/scripts/team-picker.ts, hence :global) ---- */
  .picker {
    display: grid;
    gap: var(--space-4);
  }

  .picker :global(.leagues) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .picker :global(.league) {
    min-height: var(--tap-main);
    padding: 0 var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--text);
    font-size: var(--step-0);
    font-weight: 600;
    cursor: pointer;
  }

  /* The league shown: filled, with an inner ring so it doesn't rely on colour alone. */
  .picker :global(.league[aria-pressed="true"]) {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
    box-shadow: inset 0 0 0 2px var(--surface);
  }

  .picker :global(.league-teams) {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  /* Two columns on a 360px phone, four in the desktop dialog, one at 200% text
     (the minimum is in rem, so it grows with the text). */
  .picker :global(.grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(8.5rem, 100%), 1fr));
    gap: var(--space-2);
  }

  /* A whole tile is the radio's label, so the whole tile is the target.
     scroll-margin: room around a tile scrolled into view on focus, so its
     focus ring shows too (team-picker.ts). */
  .picker :global(.team) {
    scroll-margin-block: var(--space-2);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-main);
    padding: var(--space-2) 10px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-2);
    background: var(--surface);
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
  }

  /* Long names stay inside their tile: a word too long for it breaks anywhere. */
  .picker :global(.team span) {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* A name whose longest word doesn't fit its tile spans two columns: the
     whole row on a phone, half of it on desktop (fit() in team-picker.ts
     measures with breaking inside words switched off, and never widens a
     tile in a single column). */
  .picker :global(.team.wide) {
    grid-column: span 2;
  }

  .picker:global(.measuring) :global(.team span) {
    overflow-wrap: normal;
  }

  .picker :global(.team input) {
    flex: none;
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--accent);
  }

  .picker :global(.team:hover) {
    background: var(--surface-2);
  }

  /* Checked: the radio's own dot, a 2px accent border and the favourite tint. */
  .picker :global(.team:has(input:checked)) {
    padding: 7px 9px;
    border: 2px solid var(--accent);
    background: var(--fav-tint);
  }

  /* Focus shows on the whole tile (the radio's own ring stays as a fallback). */
  .picker :global(.team:has(input:focus-visible)) {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  @media (forced-colors: active) {
    .picker :global(.league[aria-pressed="true"]) {
      forced-color-adjust: none;
      background: SelectedItem;
      color: SelectedItemText;
    }

    .picker :global(.team:has(input:checked)) {
      border-color: Highlight;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .status:empty {
    display: none;
  }

  .warning {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-1);
    background: var(--warn-bg);
    color: var(--warn-text);
    font-size: var(--step--1);
  }

  /* Only when a team is chosen (the class is on <html>, set before paint). */
  [data-when-chosen] {
    display: none;
  }

  :global(:root[data-fav-state="chosen"]) .actions [data-when-chosen] {
    display: inline-flex;
  }

  :global(:root[data-fav-state="chosen"]) .keep[data-when-chosen] {
    display: grid;
    gap: var(--space-3);
  }

  summary {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-main);
    color: var(--accent);
    font-weight: 600;
    cursor: pointer;
  }

  /* An open <details>' contents, spaced as a grid would (no wrapper element:
     the dialog is on every page, so every element counts). */
  details > :not(summary) + :not(summary) {
    margin-top: var(--space-3);
  }

  details[open] {
    padding-bottom: var(--space-2);
  }

  .note code {
    padding: 0 var(--space-1);
    border-radius: var(--radius-1);
    background: var(--surface-2);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .muted,
  .note {
    color: var(--text-muted);
    font-size: var(--step--1);
  }
</style>
