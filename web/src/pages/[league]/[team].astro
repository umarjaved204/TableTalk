---
// A team page: where the team stands, its projected points and zone chances,
// its chance of each finishing position, how its chances have moved, and its
// next and recent matches. Which pages exist, and their numbers, come from
// src/data/team-page.ts. When the league has no numbers in this build, the
// page still exists and says so (as the league page does).
//
// The same route builds the stub pages for last season's teams that aren't
// covered this season (stubPages): a short noindex page that says so, with
// the breadcrumb and links back into the site.
import Breadcrumb from "../../components/Breadcrumb.astro";
import FavName from "../../components/FavName.astro";
import FinishingChart from "../../components/FinishingChart.astro";
import LeagueUnavailable from "../../components/LeagueUnavailable.astro";
import MatchList from "../../components/MatchList.astro";
import Notice from "../../components/Notice.astro";
import TeamTrend from "../../components/TeamTrend.astro";
import UpdatedStamp from "../../components/UpdatedStamp.astro";
import { RECENT_DAYS, UPCOMING_DAYS } from "../../data/matches.ts";
import {
  cachedHistory,
  cachedLeague,
  cachedRecords,
  teamDescription,
  stubPages,
  teamPages,
  teamView,
  type StubEntry,
  type TeamPageEntry,
} from "../../data/team-page.ts";
import { formatOrdinal, formatPlaces, formatPoints, formatRange, formatSigned } from "../../format/number.ts";
import { formatChance } from "../../format/probability.ts";
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return [...teamPages(), ...stubPages()].map((entry) => ({
    params: { league: entry.league.slug, team: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: TeamPageEntry | StubEntry;
}
const { entry } = Astro.props;
const { league, name, slug } = entry;
const stub = "lastSeason" in entry ? entry : null;
const data = cachedLeague(league);
const records = cachedRecords();
const view = !stub && data.state === "ready" ? teamView(data, name, records, cachedHistory(league.id)) : null;

const title = stub
  ? `${name}: not covered this season`
  : data.state === "ready"
    ? `${name} ${data.season} predictions`
    : `${name} predictions`;
const description = stub
  ? `${name} isn't in the leagues TableTalk covers this season. It was in ${league.inSentence} in ${stub.lastSeason}.`
  : data.state === "ready" && view
    ? teamDescription(data, view)
    : `${name}: ${league.name} season predictions from TableTalk.`;
const simulations = data.state === "ready" ? new Intl.NumberFormat("en-GB").format(data.nSimulations) : "";
const crumbs = [
  { href: "/", text: "Home" },
  { href: `/${league.slug}/`, text: league.name },
  { href: `/${league.slug}/${slug}/`, text: name },
];
---

<Base title={title} description={description} noindex={stub !== null}>
  <div class="container page">
    <Breadcrumb items={crumbs} />
    {stub && (
      <>
        <h1>{name}</h1>
        <Notice title={`${name} isn't in the leagues we cover this season`}>
          <p>
            It was in {league.inSentence} in {stub.lastSeason}. TableTalk covers the top division of five
            leagues, so there are no predictions for {name} this season.
          </p>
        </Notice>
        <p class="more">
          <a href={`/${league.slug}/`}>{league.name} table and chances</a>
          <a href="/">All leagues</a>
        </p>
      </>
    )}
    {!stub && data.state !== "ready" && (
      <>
        <h1>{name}</h1>
        <LeagueUnavailable data={data} />
        <p>
          <a href={`/${league.slug}/`}>{league.name} page</a>
        </p>
      </>
    )}
    {data.state === "ready" && view && (
      <>
        <header class="team-head" data-team={slug}>
          <h1>
            <FavName name={name} link={false} />
          </h1>
          <p class="league">
            {league.name} <span class="season">{data.season}</span>
          </p>
          <UpdatedStamp
            generatedAt={data.generatedAt}
            dataThrough={data.dataThrough}
            runStatus={data.runStatus}
          />
          {data.provisional && (
            <Notice title="Provisional" tone="warn">
              <p>The table includes a result that is not confirmed yet.</p>
            </Notice>
          )}
          {data.notices.map((notice) => (
            <Notice title="Note">
              <p>{notice}</p>
            </Notice>
          ))}
        </header>

        <div class="top">
          <section class="card" aria-labelledby="now-heading">
            <h2 id="now-heading">Now and projected</h2>
            <dl class="tiles">
              <div class="tile">
                <dt>Position</dt>
                <dd class="v">{formatOrdinal(view.row.position)}</dd>
                <dd class="s">after {view.row.played} played</dd>
              </div>
              <div class="tile">
                <dt>Points</dt>
                <dd class="v">{view.row.points}</dd>
                <dd class="s">
                  won {view.row.won}, drawn {view.row.drawn}, lost {view.row.lost}
                  {view.row.pointsDeducted !== 0 && (
                    <>; includes a {formatSigned(view.row.pointsDeducted)} points adjustment</>
                  )}
                </dd>
              </div>
              <div class="tile">
                <dt>Proj. pts</dt>
                <dd class="v">{formatPoints(view.row.projectedPoints)}</dd>
                <dd class="s">range {formatRange(view.row.pointsP10, view.row.pointsP90)}</dd>
              </div>
              <div class="tile">
                <dt>Goals</dt>
                <dd class="v">
                  {view.row.goalsFor}–{view.row.goalsAgainst}
                </dd>
                <dd class="s">difference {formatSigned(view.row.goalDifference)}</dd>
              </div>
            </dl>
            <h3 class="tiles-head" id="chances-heading">
              Chances
            </h3>
            <dl class="tiles" aria-labelledby="chances-heading">
              {view.chances.map((c) => (
                <div class="tile">
                  <dt>{c.name}</dt>
                  <dd class="v">
                    {/* Every chance ends in "%" ("<1%", "34%"): shown at half size. */}
                    {formatChance(c.chance).slice(0, -1)}
                    <small>%</small>
                  </dd>
                  <dd class="s">{formatPlaces(c.positions)}</dd>
                </div>
              ))}
            </dl>
            <p class="note">
              <strong>Proj. pts</strong>: average final points across {simulations} simulated seasons;{" "}
              <strong>range</strong>: 80% of them end between these totals. <strong>Chances</strong> are the
              share of simulated seasons that end in that zone; “&lt;1%” is rare, not impossible.
            </p>
          </section>

          <div class="card">
            <FinishingChart
              team={name}
              finishing={view.row.finishing}
              mostLikely={view.mostLikely}
              bands={view.bands}
              zones={data.zones}
              nSimulations={data.nSimulations}
            />
          </div>
        </div>

        <TeamTrend team={name} trend={view.trend} />

        <div class="matches">
          <section class="card" aria-labelledby="upcoming-heading">
            <h2 id="upcoming-heading">Next matches</h2>
            {view.upcoming.length > 0 ? (
              <MatchList matches={view.upcoming} />
            ) : (
              <p class="empty">No matches in the next {UPCOMING_DAYS / 7} weeks.</p>
            )}
          </section>
          <section class="card" aria-labelledby="recent-heading">
            <h2 id="recent-heading">Recent matches</h2>
            {view.recent === null ? (
              <p class="empty">
                The track record can't be read right now, so recent matches aren't shown. Upcoming predictions
                are not affected.
              </p>
            ) : view.recent.length > 0 ? (
              <MatchList matches={view.recent} />
            ) : (
              <p class="empty">
                No locked predictions for {name} in the last {RECENT_DAYS / 7} weeks.
              </p>
            )}
          </section>
        </div>
        <p class="more">
          <a href={`/${league.slug}/`}>{league.name} table and chances</a>
          <a href={`/${league.slug}/matches/`}>All {league.name} matches</a>
        </p>
      </>
    )}
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-4) 0;
  }

  .team-head {
    display: grid;
    gap: var(--space-2);
  }

  .league {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .season {
    color: var(--text-muted);
  }

  .top,
  .matches {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }

  @media (width >= 900px) {
    .top,
    .matches {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-2);
    background: var(--surface);
  }

  .card > h2 {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border);
    font-size: var(--step-1);
  }

  /* Scoreboard tiles: a small label, the number in the display face (bold,
     equal-width digits, "%" at half size), a line under it, and a solid top
     rule in the text colour like a scoreboard's frame. Text colour only,
     never a data colour, so contrast is the normal text contrast. */
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(8.5rem, 100%), 1fr));
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-4) var(--space-4) 0;
  }

  .tiles-head {
    padding: var(--space-4) var(--space-4) 0;
    color: var(--text-muted);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tiles-head + .tiles {
    padding-top: var(--space-2);
  }

  .tile {
    display: grid;
    align-content: start;
    gap: 2px;
    min-width: 0;
    padding: var(--space-2) var(--space-3) var(--space-3);
    border: 1px solid var(--border);
    border-top: 3px solid var(--text);
    border-radius: var(--radius-1);
    background: var(--surface-2);
  }

  dt {
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
  }

  .v {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 0.95;
    letter-spacing: -0.01em;
  }

  .v small {
    margin-left: 1px;
    font-size: 0.5em;
    font-weight: 600;
  }

  .s {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .note {
    padding: var(--space-3) var(--space-4) var(--space-4);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .empty {
    padding: var(--space-4);
    color: var(--text-muted);
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
  }

  .more a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-main);
  }
</style>
