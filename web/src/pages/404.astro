---
import LeagueLinks from "../components/LeagueLinks.astro";
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page doesn't exist.">
  <div class="container page">
    <h1>Page not found</h1>
    <p>This page doesn't exist. Try one of the leagues:</p>
    <LeagueLinks />
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-8) 0;
  }
</style>
