---
// The home page: the visitor's team (or the "Pick your team" prompt), the
// five leagues at a glance, when the numbers were made, and a one-line
// summary of the live track record.
import FavouriteSlot from "../components/FavouriteSlot.astro";
import LeagueCard from "../components/LeagueCard.astro";
import TeamSelect from "../components/TeamSelect.astro";
import YourTeamCard from "../components/YourTeamCard.astro";
import { loadTeamIndex } from "../data/teams.ts";
import { cardFields, yourTeamCards } from "../data/your-team.ts";
import { scriptJson } from "../scripts/theme-script.ts";
import Notice from "../components/Notice.astro";
import { loadIndex, loadLeague } from "../data/league.ts";
import { LEAGUES } from "../data/leagues.ts";
import { loadSummary } from "../data/track-record.ts";
import { trackRecordLine } from "../format/track-record.ts";
import { formatDateTime } from "../format/time.ts";
import Base from "../layouts/Base.astro";

const index = loadIndex();
const leagues = LEAGUES.map(loadLeague);
const summary = loadSummary();

// "10,000 simulated seasons per league", when every league uses the same number.
const counts = [...new Set(leagues.flatMap((l) => (l.state === "ready" ? [l.nSimulations] : [])))];
const simulations =
  counts.length === 1 && counts[0] !== undefined
    ? `${new Intl.NumberFormat("en-GB").format(counts[0])} simulated seasons per league`
    : null;
const lastUpdate = "index" in index ? index.index.generated_at : null;

// The "Your team" card: one template, and every team's values as data
// (slug -> fields); the visitor's is filled in before the page paints
// (FavouriteSlot.astro). Data, not a copy of the card per team: that made the
// page about 300 KB, over the agreed budget.
const teams = loadTeamIndex().teams;
const cardData = scriptJson(
  Object.fromEntries(
    leagues.flatMap((data) =>
      data.state === "ready"
        ? yourTeamCards(data).map((card) => [card.slug, cardFields(card, data.league)])
        : [],
    ),
  ),
);
---

<Base
  title="Season forecasts"
  description="Football season forecasts for five European leagues: title, top places and relegation chances, updated every night."
>
  <div class="container page">
    <header class="intro">
      <h1>TableTalk</h1>
      <p class="lede">Football season forecasts for five leagues, updated every night.</p>
      <p class="facts" data-generated={lastUpdate ?? undefined}>
        {lastUpdate && (
          <span data-stale-message>
            Last update{" "}
            <time datetime={lastUpdate} data-format="datetime">
              {formatDateTime(lastUpdate, "UTC")} UTC
            </time>
          </span>
        )}
        {simulations && <span>{simulations}</span>}
      </p>
    </header>

    {"unsupported" in index && (
      <Notice title="The numbers are hidden" tone="warn">
        <p>
          The published data is in a newer format (contract {index.unsupported ?? "unknown"}) than this site
          understands. The site will be updated to read it.
        </p>
      </Notice>
    )}

    <!-- The visitor's team (or the prompt), in place before the first paint. -->
    <FavouriteSlot kind="state" class="your-team-slot" values="your-team-values">
      <template data-for="none">
        <section class="prompt" aria-labelledby="pick-heading">
          <h2 id="pick-heading">
            <span class="star-icon" aria-hidden="true"></span>Pick your team
          </h2>
          <p>See your team's chances first, and find it starred in every table.</p>
          <p class="standalone-note">
            Home-screen apps keep their own settings, separate from your browser, so pick your team again
            here.
          </p>
          <div class="pick">
            <label for="pick-team" class="visually-hidden">
              Choose a team
            </label>
            <TeamSelect id="pick-team" teams={teams} />
            <button
              type="button"
              class="button primary"
              data-fav-action="save-select"
              data-select="pick-team"
            >
              Save
            </button>
          </div>
          <p>
            <button type="button" class="link-button" data-fav-action="dismiss">
              Not now
            </button>
          </p>
          <p class="note">
            Saved in this browser only. <a href="/about/#your-team">What's stored</a>
          </p>
        </section>
      </template>
      <template data-for="gone">
        <section class="prompt solid" aria-labelledby="gone-heading">
          <h2 id="gone-heading">
            <span data-fav-text="name"></span>
            {" isn't in the leagues we cover this season"}
          </h2>
          <p data-fav-text="was-in"></p>
          <p class="actions">
            <button type="button" class="button primary" data-fav-action="open-picker">
              Pick another team
            </button>
            <button type="button" class="button" data-fav-action="remove">
              Remove
            </button>
          </p>
        </section>
      </template>
      <template data-for="paused">
        <section class="prompt solid" aria-labelledby="paused-heading">
          <h2 id="paused-heading">
            <span class="star-icon" aria-hidden="true"></span>
            <span data-fav-text="name"></span>
          </h2>
          <p>
            There's no forecast for <span data-fav-text="league"></span> right now, so your team's card can't
            be shown. Your choice is kept, and the card comes back when the forecast does.
          </p>
        </section>
      </template>
      <template data-for="@card">
        <YourTeamCard />
      </template>
      <script type="application/json" id="your-team-values" set:html={cardData} />
    </FavouriteSlot>

    <ul class="cards">
      {leagues.map((data) => (
        <li data-fav-league-item={data.league.id}>
          <LeagueCard data={data} />
        </li>
      ))}
    </ul>

    <p class="track-record">
      <strong>Track record:</strong>{" "}
      {summary.status === "ok" ? trackRecordLine(summary.data) : "not available right now."}{" "}
      <a href="/track-record/">How the predictions have done</a>
    </p>
  </div>
</Base>

<script>
  import "../scripts/local-times.ts";
</script>

<style>
  .page {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-6) 0;
  }

  .intro {
    display: grid;
    gap: var(--space-2);
  }

  .lede {
    font-size: var(--step-1);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  /* Phones: one fact per line. The browser rewrites the time in the visitor's
     zone, which changes its length; on one shared line that could change how
     the facts wrap and push the cards down (layout shift). */
  @media (width < 640px) {
    .facts {
      display: grid;
    }
  }

  .facts[data-stale="true"] [data-stale-message] {
    padding: 0 var(--space-2);
    border-radius: var(--radius-1);
    background: var(--warn-bg);
    color: var(--warn-text);
    font-weight: 600;
  }

  /* Five league cards, never one left alone on a row:
       phones          1 column
       640px+          2 + 2 + 1, the fifth card full width
       1024px+         3 + 2
       1280px+         all five in one row
     A 6-column grid makes 3 + 2 possible: the first three cards take 2
     columns each, the last two take 3 each. These rules assume five leagues
     (LEAGUES in src/data/leagues.ts); a browser test checks the rows. */
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The favourite's league card comes first and is outlined; the generated
     rules set these properties (favouriteCss in src/scripts/favourite-core.js). */
  .cards li {
    display: grid;
    order: var(--fav-order, 0);
    border-radius: var(--radius-2);
    outline: 2px solid var(--fav-league-ring, transparent);
    outline-offset: 2px;
  }

  @media (width >= 640px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cards li:nth-child(5) {
      grid-column: var(--fav-col-md, 1 / -1);
    }

    .cards li:not(:nth-child(5)) {
      grid-column: var(--fav-col-md, auto);
    }
  }

  @media (width >= 1024px) {
    .cards {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .cards li,
    .cards li:not(:nth-child(5)) {
      grid-column: span var(--fav-span-lg, 2);
    }

    .cards li:nth-child(n + 4) {
      grid-column: span var(--fav-span-lg, 3);
    }
  }

  @media (width >= 1280px) {
    .cards {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .cards li,
    .cards li:not(:nth-child(5)),
    .cards li:nth-child(n + 4) {
      grid-column: auto;
    }
  }

  /* "Your team" space. Shown from the first paint in every state that has
     something to show; collapsed for "dismissed" and "newer", and without
     JavaScript (data-needs-js). No fixed height is reserved: the right block
     is copied in while the page loads, before it is painted, so it is
     already in place at the first paint. The only later changes follow the
     visitor's own clicks (picking a team), which don't count as layout
     shift. tests/e2e/favourites.spec.ts measures the shift in every state.
     The slot element is rendered by FavouriteSlot.astro, so these rules are
     :global (a page's scoped styles don't reach a child component's elements). */
  :global(.your-team-slot) {
    display: none;
  }

  :global(
    :root[data-js]:is(
        [data-fav-state="none"],
        [data-fav-state="chosen"],
        [data-fav-state="gone"],
        [data-fav-state="paused"]
      )
      .your-team-slot
  ) {
    display: grid;
  }

  .prompt {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-2);
    background: var(--surface);
  }

  .prompt.solid {
    border-style: solid;
  }

  .prompt h2 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .pick {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .pick :global(select) {
    flex: 1 1 14rem;
    width: 100%;
    min-width: 0;
    min-height: var(--tap-main);
    padding: 0 var(--space-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-2);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-text);
    font-size: var(--step-0);
    font-weight: 600;
  }

  .note {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Only inside an app added to the home screen, which has its own storage. */
  .standalone-note {
    display: none;
    color: var(--text-muted);
  }

  @media (display-mode: standalone) {
    .standalone-note {
      display: block;
    }
  }

  .track-record {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-2);
    background: var(--surface);
  }

  .track-record a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }
</style>
