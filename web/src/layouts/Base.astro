---
// Every page: <head> (title, description, Open Graph, theme script, font
// preload), skip link, header, main content, footer.
import "../styles/global.css";
// The three fonts used at the top of every page, preloaded so they usually
// arrive within font-display: optional's ~100 ms (src/styles/fonts.css).
import displayFont from "@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url";
import displayFontSemibold from "@fontsource/barlow-condensed/files/barlow-condensed-latin-600-normal.woff2?url";
import textFont from "@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import type { LeagueInfo } from "../data/leagues.ts";
import { SHARE_IMAGE, shareImage } from "../data/share.ts";
import { earlyScript } from "../scripts/theme-script.ts";

interface Props {
  title: string;
  description: string;
  /** Keep the page out of search results (stub pages for last season's teams). */
  noindex?: boolean;
  /** The league the page belongs to: its share image is used instead of the site's. */
  league?: LeagueInfo;
}
const { title, description, noindex = false, league } = Astro.props;

// Theme and favourite team, with placeholders filled from src/themes.ts and
// the data; its CSP hash is added in astro.config.mjs.
const themeScript = earlyScript();

const fullTitle = `${title} · TableTalk`;
// The page's public address, only when the site URL is set (SITE_URL, see
// astro.config.mjs). Without it the canonical and og:url tags are left out.
const url = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
// The share image (src/data/share.ts). Apps need its full address, so like
// og:url it is only named when the site URL is set.
const share = shareImage(league);
const shareUrl = Astro.site ? new URL(share.path, Astro.site).href : null;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {url && <link rel="canonical" href={url} />}
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TableTalk" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {url && <meta property="og:url" content={url} />}
    <meta property="og:locale" content="en_GB" />
    {shareUrl && (
      <>
        <meta property="og:image" content={shareUrl} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content={String(SHARE_IMAGE.width)} />
        <meta property="og:image:height" content={String(SHARE_IMAGE.height)} />
        <meta property="og:image:alt" content={share.alt} />
        <meta name="twitter:image:alt" content={share.alt} />
      </>
    )}
    <meta name="twitter:card" content={shareUrl ? "summary_large_image" : "summary"} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFontSemibold} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <!-- First thing in <body>: after Astro's CSP <meta> in <head> (so the policy
         covers it), and before any content is painted (so no flash of the wrong theme). -->
    <script is:inline set:html={themeScript} />
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <!-- Announces what a favourite action did ("Saved. Arsenal is your team on this device."). -->
    <p class="visually-hidden" role="status" data-fav-status></p>
    <SiteFooter />
  </body>
</html>
